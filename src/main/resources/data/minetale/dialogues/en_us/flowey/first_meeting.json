{
  "placement": "top",
  "portrait_mode": "no_portrait",
  "body": {
    "id": "root",
    "type": "sequence",
    "children": [
      {
        "id": "remember_meeting",
        "type": "set",
        "state": "minetale:met_flowey",
        "value": true
      },
      {
        "id": "greeting",
        "type": "page",
        "sound": {
          "per_page": {"event": "minetale:dialogue.flowey_page_open", "source": "voice"},
          "per_grapheme": [
            {"event": "minetale:dialogue.flowey_voice", "source": "voice", "volume_multiplier": 0.8, "pitch_multiplier": {"min": 0.92, "max": 1.08}},
            {"event": "minetale:dialogue.flowey_voice_alt", "source": "voice", "volume_multiplier": 0.8, "pitch_multiplier": {"min": 0.92, "max": 1.08}}
          ]
        },
        "lines": [
          {
            "literal": "Howdy!"
          },
          {
            "literal": "I'm Flowey."
          }
        ]
      },
      {
        "id": "introduction",
        "type": "page",
        "sound": {
          "per_page": {"event": "minetale:dialogue.flowey_page_open", "source": "voice"},
          "per_grapheme": [
            {"event": "minetale:dialogue.flowey_voice", "source": "voice", "volume_multiplier": 0.8, "pitch_multiplier": {"min": 0.92, "max": 1.08}},
            {"event": "minetale:dialogue.flowey_voice_alt", "source": "voice", "volume_multiplier": 0.8, "pitch_multiplier": {"min": 0.92, "max": 1.08}}
          ]
        },
        "advance": "auto",
        "auto_delay_seconds": 1.25,
        "lines": [
          {
            "literal": "You must have lots of questions about the Underground."
          }
        ]
      },
      {
        "id": "open_debug_test_prompt",
        "type": "run",
        "package": "minetale:flowey/debug_test_prompt"
      }
    ]
  }
}
