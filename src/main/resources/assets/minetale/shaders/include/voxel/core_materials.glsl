    precise vec3 v0 = (floor(original * 2.0) + 0.5) * 0.5;
    precise vec3 v1 = mtWhite3Color(v0);
    precise vec3 v2 = clamp(v1, 0.0, 1.0);
    precise vec3 v3 = mix(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.199999928), v2);
    precise vec3 v4 = (voxel + v3);
