    precise float v6 = (v5 * 0.100000001);
    precise float v7 = sin(v6);
    precise float v8 = abs(v7);
    precise float v9 = mtDivide(floor(v8 * (4.0 + 1.0)), 4.0);
    precise float v10 = clamp(v9, 0.0, 1.0);
    precise float v11 = mix(0.0, 1.0, v10);
    return vec3(v11, 1.0, 1.0);
