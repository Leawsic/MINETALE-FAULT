// xyz 分别为 Height、Bump Strength、Bump Distance；法线邻域采样不计算颜色与发光。
vec3 coreHeight(int material, vec3 original, vec3 voxel, vec3 normal) {
    if (material == 0) return coreHeight0(original, voxel, normal);
    if (material == 1) return coreHeight1(original, voxel, normal);
    if (material == 2) return coreHeight1(original, voxel, normal);
    if (material == 3) return coreHeight2(original, voxel, normal);
    if (material == 4) return coreHeight3(original, voxel, normal);
    if (material == 5) return coreHeight4(original, voxel, normal);
    if (material == 6) return coreHeight0(original, voxel, normal);
    if (material == 7) return coreHeight5(original, voxel, normal);
    return coreHeight0(original, voxel, normal);
}
